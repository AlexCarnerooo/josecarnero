---
import Icon from './Icon.astro';
import { nav, contact } from '../data/site';

interface Props {
  /** La cabecera empieza transparente sobre una imagen a sangre. */
  overlay?: boolean;
}
const { overlay = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header" data-overlay={overlay ? '' : undefined} data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <span class="brand__name">Jose Carnero</span>
      <span class="brand__tag">Ashtanga · Rocket</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul role="list" class="site-nav__list" id="site-menu">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="site-nav__social">
          <a href={contact.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram">
            <Icon name="instagram" />
            <span class="site-nav__social-label">@{contact.instagram}</span>
          </a>
          <a href={`mailto:${contact.email}`} aria-label="Email">
            <Icon name="mail" />
            <span class="site-nav__social-label">{contact.email}</span>
          </a>
        </li>
        <li class="site-nav__cta">
          <a class="btn" href={contact.whatsapp()} target="_blank" rel="noopener">Reservar clase</a>
        </li>
      </ul>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="sr-only">Abrir menú</span>
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  /* El fondo va en un pseudo-elemento: si el blur estuviera en la propia
     cabecera, el menú móvil (position: fixed) quedaría encerrado en ella. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(19 16 13 / 0.94);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition: opacity 0.4s var(--ease);
  }
  .site-header[data-overlay]:not(.is-scrolled) { border-color: transparent; }
  .site-header[data-overlay]:not(.is-scrolled)::before { opacity: 0; }
  .site-header.is-open { transform: none; }
  .site-header.is-hidden { transform: translateY(-100%); }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.1;
    position: relative;
    z-index: 2;
  }
  .brand__name {
    font-family: var(--ff-display);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .brand__tag {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }
  .site-nav__list > li:not(.site-nav__social) > a:not(.btn) {
    position: relative;
    font-size: var(--fs-sm);
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--sand);
    transition: color 0.3s var(--ease);
  }
  .site-nav__list > li:not(.site-nav__social) > a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--ember);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .site-nav__list > li:not(.site-nav__social) > a:hover,
  .site-nav__list > li:not(.site-nav__social) > a[aria-current='page'] { color: var(--paper); }
  .site-nav__list > li:not(.site-nav__social) > a:hover::after,
  .site-nav__list > li:not(.site-nav__social) > a[aria-current='page']::after { transform: scaleX(1); }

  .site-nav__social { display: flex; gap: 1rem; }
  .site-nav__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--sand);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .site-nav__social a:hover { color: var(--ember-soft); }
  .site-nav__social-label { display: none; }
  .site-nav__cta .btn { min-height: 42px; padding: 0.6em 1.25em; }

  .menu-toggle {
    display: none;
    position: relative;
    z-index: 2;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }
  .menu-toggle__bar {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .menu-toggle__bar { top: calc(50% - 0.75px); }
  .menu-toggle__bar:nth-of-type(2) { transform: translateY(-4px); }
  .menu-toggle__bar:nth-of-type(3) { transform: translateY(4px); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-of-type(2) { transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-of-type(3) { transform: rotate(-45deg); }

  @media (max-width: 860px) {
    .menu-toggle { display: block; }

    .site-nav__list {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: safe center;
      gap: 1.25rem;
      padding: calc(var(--header-h) + 2rem) var(--gutter) 3rem;
      height: 100dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--ink);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s var(--ease), visibility 0s linear 0.4s;
    }
    .site-nav.is-open .site-nav__list {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.4s var(--ease);
    }
    .site-nav__list > li:not(.site-nav__social) > a:not(.btn) {
      font-family: var(--ff-display);
      font-size: clamp(2.4rem, 11vw, 3.5rem);
      font-weight: 300;
      color: var(--paper);
      letter-spacing: -0.02em;
    }
    .site-nav__list > li:not(.site-nav__social) > a:not(.btn)::after { display: none; }
    .site-nav__list > li:not(.site-nav__social) > a[aria-current='page'] { color: var(--ember-soft); font-style: italic; }

    .site-nav__social {
      flex-direction: column;
      gap: 0.9rem;
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
      width: 100%;
    }
    .site-nav__social-label { display: inline; font-size: var(--fs-sm); }
    .site-nav__cta { margin-top: 0.5rem; }

    @media (prefers-reduced-motion: no-preference) {
      .site-nav__list > li {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
      }
      .site-nav.is-open .site-nav__list > li { opacity: 1; transform: none; }
      .site-nav.is-open .site-nav__list > li:nth-child(2) { transition-delay: 0.05s; }
      .site-nav.is-open .site-nav__list > li:nth-child(3) { transition-delay: 0.1s; }
      .site-nav.is-open .site-nav__list > li:nth-child(4) { transition-delay: 0.15s; }
      .site-nav.is-open .site-nav__list > li:nth-child(5) { transition-delay: 0.2s; }
    }
  }
</style>
