---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}
const { images } = Astro.props;

// Versión grande para el visor, generada en build.
const full = await Promise.all(images.map((img) => getImage({ src: img.src, width: 1800, format: 'webp', quality: 78 })));
---

<div class="gallery" data-gallery>
  <ul role="list" class="gallery__grid">
    {images.map((img, i) => (
      <li>
        <button type="button" class="gallery__item media" data-index={i} data-full={full[i].src} data-alt={img.alt}>
          <Picture
            src={img.src}
            alt={img.alt}
            formats={['avif', 'webp']}
            widths={[400, 700, 1000]}
            sizes="(min-width: 900px) 50vw, 100vw"
            quality={70}
          />
          <span class="sr-only">Ampliar imagen {i + 1}</span>
        </button>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" aria-label="Visor de imágenes">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" decoding="async" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" data-close aria-label="Cerrar"><Icon name="close" size={24} /></button>
    {images.length > 1 && (
      <>
        <button type="button" class="lightbox__btn lightbox__prev" data-prev aria-label="Anterior"><Icon name="chevron-left" size={28} /></button>
        <button type="button" class="lightbox__btn lightbox__next" data-next aria-label="Siguiente"><Icon name="chevron-right" size={28} /></button>
      </>
    )}
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLButtonElement>('.gallery__item')];
    const dialog = root.querySelector('dialog')!;
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      img.src = item.dataset.full!;
      img.alt = item.dataset.alt ?? '';
      caption.textContent = `${item.dataset.alt ?? ''} · ${index + 1}/${items.length}`;
    };

    items.forEach((item, i) =>
      item.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => items[index]?.focus());

    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  });
</script>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }
  .gallery__item {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 0;
    cursor: zoom-in;
  }
  .gallery__item :global(img) { transition: transform 0.8s var(--ease), opacity 0.4s; }
  .gallery__item:hover :global(img) { transform: scale(1.03); }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: rgb(10 8 6 / 0.96);
    color: var(--paper);
  }
  .lightbox::backdrop { background: rgb(10 8 6 / 0.9); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__figure {
    display: grid;
    gap: 1rem;
    justify-items: center;
    padding: 4.5rem var(--gutter) 2rem;
    max-width: 100%;
  }
  .lightbox__img {
    max-width: min(92vw, 1600px);
    max-height: calc(100dvh - 10rem);
    width: auto;
    object-fit: contain;
  }
  .lightbox__caption { font-size: var(--fs-sm); color: var(--sand); text-align: center; }
  .lightbox__btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgb(243 236 226 / 0.08);
    color: var(--paper);
    transition: background-color 0.3s var(--ease);
  }
  .lightbox__btn:hover { background: rgb(243 236 226 / 0.18); }
  .lightbox__close { top: 1rem; right: 1rem; }
  .lightbox__prev { left: 1rem; top: 50%; translate: 0 -50%; }
  .lightbox__next { right: 1rem; top: 50%; translate: 0 -50%; }
  @media (max-width: 640px) {
    .lightbox__prev, .lightbox__next { top: auto; bottom: 1rem; translate: none; }
  }
</style>
