---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EventCard from '../components/EventCard.astro';
import { studio } from '../data/site';
import { getEvents } from '../lib/events';

import heroImg from '../assets/photos/atardecer-guerrero.jpg';
import ashtangaImg from '../assets/photos/pino.jpg';
import rocketImg from '../assets/photos/equilibrio-brazos.jpg';
import aboutImg from '../assets/photos/media-luna-invertida.jpg';
import classesImg from '../assets/photos/postura-sentada.jpg';
import eventsImg from '../assets/photos/apertura-cadera.jpg';
import quoteImg from '../assets/photos/hanumanasana.jpg';

const { upcoming } = await getEvents();
const featured = upcoming[0];

const sections = [
  {
    href: '/clases/',
    title: 'Clases',
    text: `Ashtanga cada semana en ${studio.name}. Horarios y cómo empezar.`,
    cta: 'Ver horarios',
    img: classesImg,
    pos: '60% 50%',
  },
  {
    href: '/eventos/',
    title: 'Talleres y retiros',
    text: 'Workshops, cursos y retiros para profundizar en la práctica.',
    cta: 'Ver eventos',
    img: eventsImg,
    pos: '55% 50%',
  },
  {
    href: '/sobre-mi/',
    title: 'Sobre mí',
    text: 'De bombero y artes marciales a profesor de Ashtanga y Rocket.',
    cta: 'Conoce mi camino',
    img: aboutImg,
    pos: '50% 60%',
  },
];
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media fill">
      <Picture
        src={heroImg}
        alt="Jose Carnero en una postura de guerrero invertido frente al mar al atardecer"
        formats={['avif', 'webp']}
        layout="full-width"
        loading="eager"
        fetchpriority="high"
        quality={82}
      />
    </div>
    <div class="container hero__content">
      <p class="eyebrow hero__eyebrow">Yoga en {studio.city} · Galicia</p>
      <h1 class="hero__title">
        <span class="hero__line">Jose</span>
        <span class="hero__line hero__line--indent">Carnero</span>
      </h1>
      <div class="hero__foot">
        <p class="hero__lead">
          Ashtanga &amp; Rocket Yoga.<br />
          Alineación, respiración y biomecánica.
        </p>
        <div class="actions">
          <a class="btn" href="/clases/">Horarios de clases <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href="/eventos/">Talleres y retiros</a>
        </div>
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true"><span></span></div>
  </section>

  <!-- MANIFIESTO -->
  <section class="section section--paper intro">
    <div class="container intro__grid">
      <p class="eyebrow" data-reveal>Mi enfoque</p>
      <div>
        <p class="intro__statement" data-reveal>
          Una práctica basada en la <em>alineación</em>, el movimiento del <em>prana</em> a través de la respiración y la{" "}
          <em>biomecánica</em>, para que el yoga sea sostenible y te acompañe toda la vida.
        </p>
      </div>
    </div>
  </section>

  <!-- ESTILOS -->
  <section class="section styles" aria-labelledby="estilos-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Lo que enseño</p>
        <h2 id="estilos-title" class="h2">Dos métodos, <span class="accent">una misma raíz</span></h2>
      </header>

      <div class="styles__grid">
        <article class="style-card" data-reveal>
          <div class="style-card__media media">
            <Picture
              src={ashtangaImg}
              alt="Pino sobre las manos en la arena con el mar de fondo"
              formats={['avif', 'webp']}
              widths={[400, 700, 1000]}
              sizes="(min-width: 900px) 40vw, 100vw"
              quality={82}
            />
          </div>
          <span class="style-card__num">01</span>
          <h3 class="h3">Ashtanga Vinyasa</h3>
          <p>
            El método tradicional: una serie fija de posturas encadenadas con la respiración. Disciplina, constancia y
            atención para conocer el cuerpo desde dentro, práctica a práctica.
          </p>
        </article>

        <article class="style-card style-card--offset" data-reveal style="--reveal-delay:.12s">
          <div class="style-card__media media">
            <Picture
              src={rocketImg}
              alt="Equilibrio sobre brazos en la playa al atardecer"
              formats={['avif', 'webp']}
              widths={[400, 700, 1000]}
              sizes="(min-width: 900px) 40vw, 100vw"
              quality={82}
            />
          </div>
          <span class="style-card__num">02</span>
          <h3 class="h3">Rocket Yoga</h3>
          <p>
            Creado por Larry Schultz, discípulo de Pattabhi Jois. Nace del Ashtanga con una propuesta más creativa,
            accesible y desafiante: fuerza, invertidas y libertad de movimiento.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- PRÓXIMO EVENTO (sólo si hay fechas publicadas) -->
  {featured && (
    <section class="section section--ink-2" aria-labelledby="evento-title">
      <div class="container">
        <header class="section-head" data-reveal>
          <p class="eyebrow">Próximo encuentro</p>
          <h2 id="evento-title" class="sr-only">Próximo encuentro</h2>
        </header>
        <EventCard event={featured} variant="feature" />
      </div>
    </section>
  )}

  <!-- ÍNDICE: un vistazo a todo lo que hay en la web -->
  <section class:list={['section explore', { 'section--ink-2': !featured }]} aria-labelledby="explore-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Explora</p>
        <h2 id="explore-title" class="h2">Clases, retiros <span class="accent">y mi camino</span></h2>
      </header>
      <ul role="list" class="explore__grid">
        {sections.map((item, i) => (
          <li class="explore__card" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <div class="explore__media media">
              <Picture
                src={item.img}
                alt=""
                formats={['avif', 'webp']}
                widths={[400, 700, 1000]}
                sizes="(min-width: 900px) 33vw, 100vw"
                quality={82}
                style={`object-position:${item.pos}`}
              />
            </div>
            <h3 class="h3"><a href={item.href}>{item.title}</a></h3>
            <p>{item.text}</p>
            <span class="link-arrow" aria-hidden="true">{item.cta} <Icon name="arrow" /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CITA -->
  <section class="quote" aria-label="Cita">
    <div class="quote__media fill">
      <Picture src={quoteImg} alt="" formats={['avif', 'webp']} layout="full-width" quality={82} />
    </div>
    <figure class="container quote__content" data-reveal>
      <blockquote>
        <p>
          «Yoga is like music: the rhythm of the body, the melody of the mind, and the harmony of the soul create the
          symphony of life.»
        </p>
      </blockquote>
      <figcaption>B.K.S. Iyengar</figcaption>
    </figure>
  </section>
</Base>

<style>
  /* Hero ------------------------------------------------------------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--header-h);
    padding-bottom: clamp(2.5rem, 2rem + 4vw, 5rem);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }
  /* En móvil sólo cabe una franja vertical de la foto: la centramos en la persona */
  @media (max-width: 720px) {
    .hero__media :global(img) { object-position: 56% 50%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(img) { animation: hero-zoom 2.4s var(--ease) both; }
    .hero__content > * { animation: rise 1.2s var(--ease) both; }
    .hero__title { animation-delay: 0.15s !important; }
    .hero__foot { animation-delay: 0.35s !important; }
  }
  @keyframes hero-zoom { from { transform: scale(1.08); } to { transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(19 16 13 / 0.92) 0%, rgb(19 16 13 / 0.35) 45%, rgb(19 16 13 / 0) 70%),
      linear-gradient(to bottom, rgb(19 16 13 / 0.5) 0%, rgb(19 16 13 / 0) 22%);
  }
  .hero__content { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  .hero__eyebrow { color: var(--sand); }
  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 250;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }
  .hero__line { display: block; }
  .hero__line--indent { padding-left: 0.55em; font-style: italic; font-weight: 200; }
  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .hero__lead { font-size: var(--fs-lg); color: var(--sand); line-height: 1.5; }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    width: 1px;
    height: 2.5rem;
    background: var(--line);
    overflow: hidden;
    display: none;
  }
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .hero__scroll { display: block; }
  }
  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: var(--paper);
    animation: scroll-cue 2.2s var(--ease) infinite;
  }
  @keyframes scroll-cue { from { transform: translateY(-100%); } to { transform: translateY(100%); } }

  /* Intro -------------------------------------------------------------- */
  .intro__grid { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .intro__grid { grid-template-columns: 14rem 1fr; gap: 3rem; }
    .intro__grid > .eyebrow { padding-top: 1rem; }
  }
  .intro__statement {
    font-family: var(--ff-display);
    font-size: var(--fs-2xl);
    font-weight: 300;
    line-height: 1.22;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }
  .intro__statement em { color: #b5612a; }
  /* Section head ----------------------------------------------------- */
  .section-head { display: grid; gap: 1rem; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .section-head--row {
    grid-template-columns: 1fr;
    align-items: end;
  }
  @media (min-width: 720px) {
    .section-head--row { grid-template-columns: 1fr auto; }
  }
  .section-head--row > div { display: grid; gap: 1rem; }

  /* Estilos ------------------------------------------------------------ */
  .styles__grid {
    display: grid;
    gap: 4rem;
  }
  @media (min-width: 900px) {
    .styles__grid { grid-template-columns: 1fr 1fr; gap: clamp(3rem, 6vw, 7rem); }
    .style-card--offset { margin-top: 8rem; }
  }
  .style-card { display: grid; gap: 1rem; align-content: start; }
  .style-card__media { aspect-ratio: 4 / 5; margin-bottom: 1rem; }
  .style-card__num {
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    color: var(--ember);
  }
  .style-card p { color: var(--sand); max-width: 48ch; }

  /* Índice ------------------------------------------------------------ */
  .explore__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 3rem 2rem;
  }
  .explore__card { position: relative; display: grid; gap: 0.75rem; align-content: start; justify-items: start; }
  .explore__media { aspect-ratio: 4 / 3; width: 100%; margin-bottom: 0.75rem; }
  .explore__media :global(img) { transition: transform 1.2s var(--ease); }
  .explore__card:hover .explore__media :global(img) { transform: scale(1.04); }
  .explore__card h3 a { text-decoration: none; }
  .explore__card h3 a::after { content: ''; position: absolute; inset: 0; }
  .explore__card p { color: var(--sand); max-width: 40ch; }
  .explore__card .link-arrow { margin-top: 0.25rem; }
  .explore__card:hover .link-arrow :global(svg) { transform: translateX(4px); }

  /* Cita ---------------------------------------------------------------- */
  .quote {
    position: relative;
    isolation: isolate;
    min-height: 80svh;
    display: grid;
    align-items: center;
    padding-block: var(--section);
    overflow: hidden;
  }
  .quote__media { position: absolute; inset: 0; z-index: -1; }
  .quote__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .quote__media::after { content: ''; position: absolute; inset: 0; background: rgb(19 16 13 / 0.62); }
  .quote__content { display: grid; gap: 1.5rem; justify-items: center; text-align: center; }
  .quote blockquote p {
    font-family: var(--ff-display);
    font-size: var(--fs-2xl);
    font-weight: 300;
    font-style: italic;
    line-height: 1.2;
    max-width: 28ch;
    margin-inline: auto;
  }
  .quote figcaption {
    font-size: var(--fs-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sand);
  }
</style>
